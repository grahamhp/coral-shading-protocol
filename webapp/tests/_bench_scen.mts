import { readFileSync } from "node:fs";
import { lightFromJson } from "../src/core/surface.ts";
import { deploymentDays, constantScenario, solveDynamic, runPeriod, transmission } from "../src/core/scenarios.ts";
import { targetGrid } from "../src/core/geometry.ts";
const T = JSON.parse(readFileSync(new URL("../../shared/tables/light_tables.json", import.meta.url), "utf8"));
const EX = JSON.parse(readFileSync(new URL("../../shared/examples/sipaway.json", import.meta.url), "utf8"));
const site = { lat: EX.lat, lon: EX.lon, tz: EX.utc_offset_h, light: lightFromJson(EX.light) };
const water = { kd: 0.10, w0: 0.7, depth: 10 };
const tgt = { shape: "circle" as const, lx: 1.1, ly: 1.1 };
const all = deploymentDays([2025, 4, 28], [2025, 8, 8], 1);
let t0 = performance.now();
const cs = constantScenario(site, water, tgt, 0.75, all, T, 0.20, undefined, 0, undefined, 0.1);
const Tc = transmission(cs.result); let t1 = performance.now();
console.log("constant all days grid0.1", (t1 - t0).toFixed(0), "ms", cs.result.nPoints, "pts", Tc.toFixed(4));
t0 = performance.now(); const sol = solveDynamic(site, water, tgt, 0.75, all, T, Tc, { spacing: 0.1, solveEvery: 5 }); t1 = performance.now();
console.log("solve every5 grid0.1", (t1 - t0).toFixed(0), "ms iters", sol.iterations, sol.panel.lx.toFixed(3));
t0 = performance.now(); const r = runPeriod(site, water, [sol.panel], targetGrid(tgt, 0.05), all, T, 16); t1 = performance.now();
console.log("dyn period grid0.05", (t1 - t0).toFixed(0), "ms", r.nPoints, "pts T", transmission(r).toFixed(4));
t0 = performance.now(); const r2 = runPeriod(site, water, [sol.panel], targetGrid(tgt, 0.025), all.filter((_, i) => i % 7 === 0), T, 16); t1 = performance.now();
console.log("dyn every7 grid0.025", (t1 - t0).toFixed(0), "ms", r2.nPoints, "pts");
